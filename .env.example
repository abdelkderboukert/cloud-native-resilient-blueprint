# Enterprise Event-Driven Micro-Platform (EEMP) Environment Variables
DJANGO_SECRET_KEY=enterprise-super-secure-random-token-here
DEBUG=False
ALLOWED_HOSTS=api.enterprise.local,django-service,localhost,127.0.0.1

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=enterprise_db
DATABASE_URL=postgres://app_user:secure_password@postgres-cluster-rw.data-tier.svc.cluster.local:5432/enterprise_db

# RustFS / S3 Object Storage
RUSTFS_ACCESS_KEY=enterprise-admin-key
RUSTFS_SECRET_KEY=enterprise-super-secret-key-32chars
RUSTFS_ENDPOINT=http://rustfs-service.data-tier.svc.cluster.local:9000
BACKUP_BUCKET=postgres-backups

# Apache Kafka Distributed Messaging
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-0.kafka-headless.messaging-tier.svc.cluster.local:9092
KAFKA_USER_EVENTS_TOPIC=user.lifecycle.events
KAFKA_ARTICLE_EVENTS_TOPIC=article.lifecycle.events
CLUSTER_ID=4L62EnnTQNmGQQuUhqwawA
